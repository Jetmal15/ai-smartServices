    "test:phase7": "node --test tests/phase7/database.test.mjs",
    "db:setup": "node --env-file=.env scripts/setup-database.mjs",
    "db:docs": "node scripts/generate-schema-docs.mjs",
    "db:migrate-profiles": "node --env-file=.env scripts/migrate-profiles-to-users.mjs",
    "test": "npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13 && npm run test:phase14",
    "test:phase14": "node --test tests/phase14/auth.test.mjs tests/phase14/flows.test.mjs tests/phase14/security.test.mjs",
    "test:phase8": "node --test tests/phase8/complaints.test.mjs",

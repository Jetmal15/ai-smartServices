# Copy this file to `.env` and fill in the values from your Appwrite console.
# `.env` is git-ignored – never commit it. Restart `npm run dev` after editing.
#
# Only VITE_-prefixed variables reach the browser, and they are PUBLIC.
# NEVER put an Appwrite API key (server secret) in this file.

# Appwrite Cloud: https://<REGION>.cloud.appwrite.io/v1  (copy the exact value from Settings in the console)
# Self-hosted:    https://<your-domain>/v1
VITE_APPWRITE_ENDPOINT=

# Console > your project > Settings > Project ID
VITE_APPWRITE_PROJECT_ID=

# Console > Databases > your database > Settings (Database ID)
VITE_APPWRITE_DATABASE_ID=
